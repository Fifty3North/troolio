<Project>
  <PropertyGroup>
    <TroolioCoreVersion>10.0.8</TroolioCoreVersion>
    <TroolioExtensionsVersion>10.0.2</TroolioExtensionsVersion>
    <OrleansVersion>10.0.0</OrleansVersion>
    <EntityFrameworkVersion>10.0.12</EntityFrameworkVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseLocalExtensions Condition="'$(UseLocalExtensions)' == ''">false</UseLocalExtensions>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
