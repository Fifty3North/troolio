<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>$(TroolioExtensionsVersion)</Version>
    <Authors>Fifty3North (F3N Limited)</Authors>
    <Description>Redis derived read models and partition change feeds for Troolio applications.</Description>
    <PackageProjectUrl>https://fifty3north.github.io/troolio-docs/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Fifty3North/troolio.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>package-readme.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Troolio.Core" Version="$(TroolioCoreVersion)" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    <PackageReference Include="ValueInjecter" Version="3.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <None Include="package-readme.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
